# Przykład — podmień domenę, ścieżki certyfikatów i adres hosta Dockge.
server {
    listen 443 ssl;
    http2 on;
    server_name zakupy.example.ts.net;

    ssl_certificate     /etc/ssl/zakupy/fullchain.pem;
    ssl_certificate_key /etc/ssl/zakupy/privkey.pem;

    location / {
        proxy_pass http://192.168.1.10:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSE — bez buforowania i z długim timeoutem
    location /api/events {
        proxy_pass http://192.168.1.10:3000;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}

server {
    listen 80;
    server_name zakupy.example.ts.net;
    return 301 https://$host$request_uri;
}
