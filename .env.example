# Skopiuj do .env i dostosuj. Prawdziwy .env NIE trafia do gita.

# Ścieżka do pliku bazy SQLite (w kontenerze: /app/data/zakupy.db)
DATABASE_PATH=./data/zakupy.db

# Ustawienia serwera produkcyjnego (adapter-node)
PORT=3000
HOST=0.0.0.0
# Publiczny adres aplikacji (za nginx) — potrzebny do ochrony CSRF formularzy
ORIGIN=https://zakupy.example.ts.net
